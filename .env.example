# --- Scraping (Apify free plan: $5/month credit, no card) ---
APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR=harvestapi/linkedin-profile-scraper
APIFY_LINKEDIN_FALLBACK_ACTOR=bovi/linkedin-profile-scraper
APIFY_INSTAGRAM_ACTOR=apify/instagram-profile-scraper

# --- LLMs (free tiers) ---
GEMINI_API_KEY=
# Second account (separate free quota), used after the first in each provider
GEMINI_API_KEY_2=
GROQ_API_KEY=
# Second account (separate free quota), used after the first in each provider
GROQ_API_KEY_2=
# Optional overrides: ordered "provider:model" chains
LLM_CHAIN_ANALYSIS=gemini2:gemini-3-flash-preview,gemini2:gemini-3.5-flash,groq2:openai/gpt-oss-120b,groq2:qwen/qwen3.8-27b,gemini:gemini-3-flash-preview,gemini:gemini-2.5-flash,groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b
LLM_CHAIN_DATE=gemini2:gemini-3-flash-preview,gemini2:gemini-3.1-flash-lite,groq2:openai/gpt-oss-120b,groq2:qwen/qwen3.8-27b,groq2:openai/gpt-oss-20b,gemini:gemini-2.5-flash-lite,gemini:gemini-3.1-flash-lite,groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b
LLM_CHAIN_DEBRIEF=gemini2:gemini-3-flash-preview,gemini2:gemini-3.1-flash-lite,groq2:openai/gpt-oss-120b,groq2:qwen/qwen3.8-27b,groq2:openai/gpt-oss-20b,gemini:gemini-2.5-flash-lite,gemini:gemini-3.1-flash-lite,groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b

# --- Storage (Supabase free). Leave empty to use the local JSON file store in .data/ ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Salt for hashing visitor IPs used by the rate limiter
IP_HASH_SALT=change-me
# Dates each new person's agent goes on
DATES_PER_PERSON=2
# 1 = no network: synthetic scrapes + mock LLM (local dev / tests)
MOCK_EXTERNALS=0
# Secret for the Vercel cron / keepalive endpoints
CRON_SECRET=

# Groq free plan (per model): 30 RPM, 1K RPD, 8K TPM, 200K TPD
LLM_TPM_GROQ=7500
LLM_TPD_GROQ=190000
LLM_RPM_GROQ=28
LLM_RPD_GROQ=950
LLM_RPM_GEMINI=8
# Gemini free tier: 20 requests/day per model
LLM_RPD_GEMINI=19
